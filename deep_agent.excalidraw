      "text": "Langchains in-built Guardrails middleware",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Langchains in-built Guardrails middleware",
      "autoResize": true,
