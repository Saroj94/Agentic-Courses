    },
    {
      "id": "NxO6Rw36KUqaaQ_n2AJcj",
      "type": "text",
      "x": 31.95084974962333,
      "y": 1994.6404928299432,
      "width": 442.1596984863281,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 1835704561,
      "version": 155,
      "versionNonce": 1983796817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790209135491,
      "link": null,
      "locked": false,
      "text": "1. PII Middleware\n- Detects Email, credit cards, IP address, url\n- masking/hash\n- It applies on input/output, tool calls",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. PII Middleware\n- Detects Email, credit cards, IP address, url\n- masking/hash\n- It applies on input/output, tool calls",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "indWATaw4UPs9-OD_HD9i",
      "type": "text",
      "x": 31.007861413539672,
      "y": 2103.284261954611,
      "width": 492.0996398925781,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 317646751,
      "version": 173,
      "versionNonce": 1604806399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790211443688,
      "link": null,
      "locked": false,
      "text": "2. Human-in-the-loop\n- It pauses agents before calling a sensitive tools\n for human to approve or rejects.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Human-in-the-loop\n- It pauses agents before calling a sensitive tools\n for human to approve or rejects.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uX0Y5gYPoBBRLl57ItIQb",
      "type": "text",
      "x": 30.60475189582405,
      "y": 2184.6260039221365,
      "width": 333.039794921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 515130961,
      "version": 181,
      "versionNonce": 1786279391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790211447887,
      "link": null,
      "locked": false,
      "text": "3. Before agent hooks\n- Runs before llm calls\n- Zero costs for blocked request ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Before agent hooks\n- Runs before llm calls\n- Zero costs for blocked request ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "U_e3weJPesC4GwOLW5H2A",
      "type": "text",
      "x": 27.95214730157329,
      "y": 2269.4589622484436,
      "width": 436.5196838378906,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1825986577,
      "version": 172,
      "versionNonce": 1244049663,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790211536565,
      "link": null,
      "locked": false,
      "text": "4. After agent hooks\n- validates the response before user sees it.\n- Replace the unsafe content",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. After agent hooks\n- validates the response before user sees it.\n- Replace the unsafe content",
      "autoResize": true,
      "lineHeight": 1.25
    },
